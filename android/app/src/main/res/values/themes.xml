<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this theme only carries the splash screen
         (androidx.core.splashscreen) and a transparent system-bar base. -->
    <style name="Theme.Ummi" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Ummi.Main</item>
    </style>

    <style name="Theme.Ummi.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
